#!/bin/sh
# kiwix-theme (offline-shelf) - tiny helper for themes that use kiwix-serve's
# KIWIX_SERVE_CUSTOMIZED_RESOURCES mechanism.
#
# POSIX sh only. Needs curl for the "base" and "check" commands.
# Nothing here is required at runtime: kiwix-serve only reads the
# generated resources.txt file.
#
# SPDX-License-Identifier: GPL-3.0-or-later

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
THEMES="$ROOT/themes"

# Stock kiwix-serve files a theme usually starts from.
BASE_FILES="skin/index.css skin/kiwix.css skin/taskbar.css skin/error.css skin/search_results.css"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [args]

Commands:
  list                         List available themes
  new <theme>                  Create a new theme from themes/_template
  base <theme> <server-url>    Copy the stock CSS of a running kiwix-serve
                               into the theme as a starting point
  build <theme> [prefix]       Write themes/<theme>/resources.txt.
                               prefix = where themes/ is mounted inside the
                               container (default: /themes)
  build-all [prefix]           Run build for every theme
  check <theme> <server-url>   Verify that a running kiwix-serve serves
                               the theme's files
EOF
}

die() { echo "error: $*" >&2; exit 1; }

theme_dir() {
  [ -n "${1:-}" ] || die "missing theme name"
  case "$1" in */*|.*|_*) die "invalid theme name: $1" ;; esac
  printf '%s/%s' "$THEMES" "$1"
}

mime_for() {
  case "$1" in
    *.css)   echo text/css ;;
    *.js)    echo application/javascript ;;
    *.html)  echo text/html ;;
    *.svg)   echo image/svg+xml ;;
    *.png)   echo image/png ;;
    *.jpg|*.jpeg) echo image/jpeg ;;
    *.webp)  echo image/webp ;;
    *.ico)   echo image/x-icon ;;
    *.woff2) echo font/woff2 ;;
    *.woff)  echo font/woff ;;
    *.ttf)   echo font/ttf ;;
    *.json)  echo application/json ;;
    *.txt)   echo text/plain ;;
    *)       echo application/octet-stream ;;
  esac
}

cmd_list() {
  for d in "$THEMES"/*/; do
    name=$(basename "$d")
    case "$name" in _*) continue ;; esac
    printf '%s\n' "$name"
  done
}

cmd_new() {
  dir=$(theme_dir "${1:-}")
  [ ! -e "$dir" ] || die "theme already exists: $1"
  cp -R "$THEMES/_template" "$dir"
  echo "Created $dir"
}

cmd_base() {
  dir=$(theme_dir "${1:-}")
  url=${2:-}
  [ -n "$url" ] || die "missing server url, e.g. http://raspberrypi:8090"
  [ -d "$dir" ] || die "no such theme: $1"
  url=${url%/}
  for f in $BASE_FILES; do
    target="$dir/files/$f"
    if [ -e "$target" ]; then
      echo "skip  $f (already in theme)"
      continue
    fi
    mkdir -p "$(dirname "$target")"
    if curl -fs "$url/$f" -o "$target"; then
      echo "fetch $f"
    else
      rm -f "$target"
      echo "miss  $f (not served by this kiwix-serve version)"
    fi
  done
}

cmd_build() {
  dir=$(theme_dir "${1:-}")
  prefix=${2:-/themes}
  prefix=${prefix%/}
  name=$1
  [ -d "$dir/files" ] || die "no files/ folder in theme: $name"
  out="$dir/resources.txt"
  tmp="$out.tmp"
  : > "$tmp"
  (cd "$dir/files" && find . -type f ! -name '.*' | sed 's|^\./||' | LC_ALL=C sort) |
  while IFS= read -r rel; do
    case "$rel" in *" "*) die "file names must not contain spaces: $rel" ;; esac
    printf '/%s %s %s/%s/files/%s\n' "$rel" "$(mime_for "$rel")" "$prefix" "$name" "$rel" >> "$tmp"
  done
  mv "$tmp" "$out"
  echo "Wrote $out ($(wc -l < "$out" | tr -d ' ') entries)"
}

cmd_build_all() {
  for name in $(cmd_list); do cmd_build "$name" "${1:-/themes}"; done
}

cmd_check() {
  dir=$(theme_dir "${1:-}")
  url=${2:-}
  [ -n "$url" ] || die "missing server url"
  url=${url%/}
  [ -f "$dir/resources.txt" ] || die "run build first"
  fail=0
  while read -r path mime file; do
    rel=${file#*/files/}
    if curl -fsS "$url$path" | cmp -s - "$dir/files/$rel"; then
      echo "ok    $path"
    else
      echo "FAIL  $path (server does not return the theme file)"
      fail=1
    fi
  done < "$dir/resources.txt"
  return $fail
}

case "${1:-}" in
  list)      shift; cmd_list "$@" ;;
  new)       shift; cmd_new "$@" ;;
  base)      shift; cmd_base "$@" ;;
  build)     shift; cmd_build "$@" ;;
  build-all) shift; cmd_build_all "$@" ;;
  check)     shift; cmd_check "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 1 ;;
esac
