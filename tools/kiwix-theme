#!/bin/sh
# kiwix-theme (offline-shelf) - builds theme packs for kiwix-serve's
# KIWIX_SERVE_CUSTOMIZED_RESOURCES mechanism.
#
# A pack combines one theme for light devices with one for dark devices.
# The shared layout lives in base/, each theme is a single themes/<name>/theme.css
# holding its tokens and optional extra rules.
#
# POSIX sh and awk only. Nothing here is needed at runtime: kiwix-serve only
# reads the generated resources.txt and the CSS files it points to.
#
# SPDX-License-Identifier: GPL-3.0-or-later

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
THEMES="$ROOT/themes"
BASE="$ROOT/base"
DIST="$ROOT/dist"

# Colour tokens every theme must define (no defaults on purpose).
REQUIRED="color-scheme --bg --surface --surface-2 --line --line-strong --ink --ink-2 --muted --accent --accent-hover --accent-ink --accent-soft --focus --overlay"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [args]

Commands:
  list                       List themes with their scheme and description
  build <light> <dark> [prefix]
                             Build one pack into dist/<light>+<dark>/.
                             prefix = where dist/ is mounted inside the
                             container (default: /themes)
  build-all [prefix]         Build every light+dark combination
  check                      Check that every theme defines all colour tokens
  check-server <url> <pack>  Verify that a running kiwix-serve serves a pack
EOF
}

die() { echo "error: $*" >&2; exit 1; }

theme_file() {
  [ -n "${1:-}" ] || die "missing theme name"
  case "$1" in */*|.*|_*) die "invalid theme name: $1" ;; esac
  f="$THEMES/$1/theme.css"
  [ -f "$f" ] || die "no such theme: $1"
  printf '%s' "$f"
}

# meta <file> <key>: value from the "/*! name: X | scheme: Y | about: Z */" line
meta() {
  sed -n '1s/^\/\*! *//; 1s/ *\*\/ *$//; 1p' "$1" | tr '|' '\n' |
    sed -n "s/^ *$2: *//p" | sed 's/ *$//'
}

# tokens <file>: declarations inside the first ":root {" ... "}" block
tokens() {
  awk 'state==0 && /^:root *\{/ {state=1; next}
       state==1 && /^\}/ {exit}
       state==1 {print}' "$1"
}

# extras <file>: everything after the first :root block
extras() {
  awk 'state==2 {print; next}
       state==0 && /^:root *\{/ {state=1; next}
       state==1 && /^\}/ {state=2}' "$1"
}

indent() { sed 's/^/  /'; }

decls() {
  # strip comment-only lines from a declaration file
  grep -v '^ *\(/\*\|\*\)' "$1" | sed '/^ *$/d'
}

compose_kiwix_css() {
  light=$1 dark=$2
  lf=$(theme_file "$light"); df=$(theme_file "$dark")
  cat <<EOF
/*
 * offline-shelf · kiwix.css for the pack "$light+$dark"
 * Light devices: $(meta "$lf" name). Dark devices: $(meta "$df" name).
 * Generated by tools/kiwix-theme from base/ and themes/. Do not edit;
 * change the theme files and rebuild instead.
 * SPDX-License-Identifier: GPL-3.0-or-later
 */

:root {
EOF
  decls "$BASE/icons.css" | indent
  decls "$BASE/defaults.css" | indent
  tokens "$lf" | sed 's/^ *//' | indent
  echo "}"
  echo
  if [ -n "$(extras "$lf" | sed '/^ *$/d')" ]; then
    echo "@media not all and (prefers-color-scheme: dark) {"
    extras "$lf" | indent
    echo "}"
    echo
  fi
  echo "@media (prefers-color-scheme: dark) {"
  echo "  :root {"
  decls "$BASE/defaults.css" | indent | indent
  tokens "$df" | sed 's/^ *//' | indent | indent
  echo "  }"
  extras "$df" | indent
  echo "}"
  echo
  cat "$BASE/skin/kiwix.css"
}

cmd_list() {
  for f in "$THEMES"/*/theme.css; do
    name=$(basename "$(dirname "$f")")
    printf '%-12s %-6s %s\n' "$name" "$(meta "$f" scheme)" "$(meta "$f" about)"
  done
}

cmd_build() {
  light=${1:-}; dark=${2:-}; prefix=${3:-/themes}
  [ -n "$light" ] && [ -n "$dark" ] || die "usage: build <light> <dark> [prefix]"
  pack="$light+$dark"
  out="$DIST/$pack"
  mkdir -p "$out" "$DIST/skin"
  compose_kiwix_css "$light" "$dark" > "$out/kiwix.css"
  cp "$BASE/skin/index.css" "$BASE/skin/taskbar.css" "$DIST/skin/"
  cat > "$out/resources.txt" <<EOF
/skin/kiwix.css text/css $prefix/$pack/kiwix.css
/skin/index.css text/css $prefix/skin/index.css
/skin/taskbar.css text/css $prefix/skin/taskbar.css
EOF
  echo "Built $pack"
}

cmd_build_all() {
  prefix=${1:-/themes}
  for lf in "$THEMES"/*/theme.css; do
    [ "$(meta "$lf" scheme)" = light ] || continue
    for df in "$THEMES"/*/theme.css; do
      [ "$(meta "$df" scheme)" = dark ] || continue
      cmd_build "$(basename "$(dirname "$lf")")" "$(basename "$(dirname "$df")")" "$prefix" >/dev/null
    done
  done
  echo "Built $(ls -d "$DIST"/*+* | wc -l | tr -d ' ') packs in $DIST"
}

cmd_check() {
  status=0
  for f in "$THEMES"/*/theme.css; do
    name=$(basename "$(dirname "$f")")
    t=$(tokens "$f")
    for tok in $REQUIRED; do
      printf '%s\n' "$t" | grep -q "^ *$tok:" || { echo "$name: missing $tok"; status=1; }
    done
    case "$(meta "$f" scheme)" in light|dark) ;; *) echo "$name: scheme must be light or dark"; status=1 ;; esac
    [ -n "$(meta "$f" name)" ] || { echo "$name: missing name"; status=1; }
  done
  [ $status -eq 0 ] && echo "All themes OK"
  return $status
}

cmd_check_server() {
  url=${1:-}; pack=${2:-}
  [ -n "$url" ] && [ -n "$pack" ] || die "usage: check-server <url> <pack>"
  command -v curl >/dev/null || die "curl is required for check-server"
  url=${url%/}
  ok=0
  for f in kiwix.css; do
    curl -fsS "$url/skin/$f" | cmp -s - "$DIST/$pack/$f" && echo "ok   /skin/$f" || { echo "DIFF /skin/$f"; ok=1; }
  done
  for f in index.css taskbar.css; do
    curl -fsS "$url/skin/$f" | cmp -s - "$DIST/skin/$f" && echo "ok   /skin/$f" || { echo "DIFF /skin/$f"; ok=1; }
  done
  return $ok
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  list) cmd_list ;;
  build) cmd_build "$@" ;;
  build-all) cmd_build_all "$@" ;;
  check) cmd_check ;;
  check-server) cmd_check_server "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
